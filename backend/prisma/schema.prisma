generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                        @id @default(autoincrement())
  email              String                     @unique
  password           String
  name               String
  role               Role                       @default(BUYER)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  villageId          Int?
  cart               Cart?
  assignedComplaints Complaint[]                @relation("AssignedComplaints")
  complaints         Complaint[]                @relation("UserComplaints")
  complaintResponses ComplaintResponse[]
  cooperativeAdmin   CooperativeDigital?
  cooperativeMember  CooperativeDigitalMember[]
  disasterReports    DisasterInfo[]
  donations          Donation[]
  donationDonors     DonationDonor[]
  enterpriseOwner    Enterprise?
  enterpriseMember   EnterpriseMember[]
  farms              Farm[]
  farmOrders         FarmOrder[]
  localReward        LocalReward?
  notifications      Notification[]
  Order              Order[]
  payments           Payment[]
  products           Product[]
  reviews            Review[]
  store              Store?
  umkm               UMKM?
  communityComments  UMKMComment[]
  communityPosts     UMKMCommunity[]
  village            Village?                   @relation(fields: [villageId], references: [id])
  documentOfficer    VillageDocument[]          @relation("DocumentOfficer")
  documentRequests   VillageDocument[]          @relation("DocumentRequester")
  eventParticipants  VillageEventParticipant[]
  villageInfos       VillageInfo[]
  // courierLogistics   VillageLogistics[]         @relation("courier")
  villagePotentials  VillagePotential[]
  wishlist           WishlistItem[]
}

model Store {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique
  description      String?
  logo             String?
  banner           String?
  address          String?
  phone            String?
  isActive         Boolean           @default(true)
  rating           Float             @default(0)
  totalSales       Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sellerId         Int               @unique
  enterpriseStores EnterpriseStore[]
  products         Product[]
  seller           User              @relation(fields: [sellerId], references: [id])
  umkm             UMKM?
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                  Int                         @id @default(autoincrement())
  name                String
  slug                String                      @unique
  description         String?
  price               Float                       @default(0)
  stock               Int                         @default(0)
  imageUrl            String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  categoryId          Int
  sellerId            Int
  storeId             Int?
  weight              Float?
  villageId           Int?
  cartItems           CartItem[]
  cooperativeProducts CooperativeDigitalProduct[]
  enterpriseProducts  EnterpriseProduct[]
  orderItems          OrderItem[]
  category            Category                    @relation(fields: [categoryId], references: [id])
  seller              User                        @relation(fields: [sellerId], references: [id])
  store               Store?                      @relation(fields: [storeId], references: [id])
  village             Village?                    @relation(fields: [villageId], references: [id])
  promotions          Promotion[]
  reviews             Review[]
  umkmProducts        UMKMProduct[]
  wishlistItems       WishlistItem[]
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(1)
  cartId    Int
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // ← TAMBAHKAN @updatedAt

  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  productId Int
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Payment {
  id        Int       @id @default(autoincrement())
  orderId   Int
  userId    Int
  method    String
  amount    Float
  status    String
  proof     String?
  paidAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  order     Order     @relation(fields: [orderId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model Shipping {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique
  method         String
  cost           Float
  trackingNumber String?
  status         String
  address        String
  receiverName   String?
  receiverPhone  String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id])

  @@index([status])
}

model UMKM {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique
  name             String
  description      String?
  address          String
  phone            String
  verifiedAt       DateTime?
  verifiedBy       Int?
  website          String?
  socialMedia      Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  businessLicense  String?
  certificate      String?
  certificateId    String?
  email            String
  idCard           String?
  isVerified       Boolean           @default(false)
  photo            String?
  storeId          Int               @unique
  subCategory      String?
  category         String
  status           String            @default("PENDING")
  villageId        Int?
  financialRecords FinancialRecord[]
  promotions       Promotion[]
  store            Store             @relation(fields: [storeId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  village          Village?          @relation(fields: [villageId], references: [id])
  products         UMKMProduct[]
}

model UMKMProduct {
  id             Int       @id @default(autoincrement())
  productId      Int
  umkmId         Int
  productionDate DateTime?
  expiryDate     DateTime?
  batchNumber    String?
  halal          Boolean   @default(false)
  organic        Boolean   @default(false)
  bpom           Boolean   @default(false)
  bpomNumber     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  product        Product   @relation(fields: [productId], references: [id])
  umkm           UMKM      @relation(fields: [umkmId], references: [id])
}

model Promotion {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  type          String
  discountType  String
  discountValue Float
  startDate     DateTime
  endDate       DateTime
  productId     Int?
  umkmId        Int?
  isActive      Boolean  @default(true)
  maxUsage      Int      @default(-1)
  usedCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product? @relation(fields: [productId], references: [id])
  umkm          UMKM?    @relation(fields: [umkmId], references: [id])
}

model UMKMCommunity {
  id        Int           @id @default(autoincrement())
  title     String
  content   String
  category  String
  authorId  Int
  likes     Int           @default(0)
  views     Int           @default(0)
  status    String        @default("PUBLISHED")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  comments  UMKMComment[]
  author    User          @relation(fields: [authorId], references: [id])
}

model UMKMComment {
  id        Int           @id @default(autoincrement())
  content   String
  authorId  Int
  postId    Int
  parentId  Int?
  likes     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation(fields: [authorId], references: [id])
  parent    UMKMComment?  @relation("UMKMCommentReplies", fields: [parentId], references: [id])
  children  UMKMComment[] @relation("UMKMCommentReplies")
  post      UMKMCommunity @relation(fields: [postId], references: [id])
}

model FinancialRecord {
  id          Int      @id @default(autoincrement())
  type        String
  category    String
  amount      Float
  description String
  date        DateTime
  reference   String?
  umkmId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  umkm        UMKM     @relation(fields: [umkmId], references: [id])
}

model CooperativeDigital {
  id                 Int                              @id @default(autoincrement())
  name               String
  slug               String                           @unique
  type               CooperativeDigitalType           @default(KUD)
  description        String?
  registrationNumber String
  establishmentDate  DateTime
  address            String
  phone              String
  email              String
  website            String?
  certificateUrl     String?
  logo               String?
  banner             String?
  status             CooperativeDigitalStatus         @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         Int?
  adminId            Int                              @unique
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  admin              User                             @relation(fields: [adminId], references: [id])
  announcements      CooperativeDigitalAnnouncement[]
  loans              CooperativeDigitalLoan[]
  meetings           CooperativeDigitalMeeting[]
  members            CooperativeDigitalMember[]
  products           CooperativeDigitalProduct[]
  savings            CooperativeDigitalSavings[]
  transactions       CooperativeDigitalTransaction[]
}

model CooperativeDigitalMember {
  id               Int                             @id @default(autoincrement())
  cooperativeId    Int
  userId           Int
  memberNumber     String                          @unique
  joinDate         DateTime                        @default(now())
  isActive         Boolean                         @default(true)
  mandatorySavings Float                           @default(0)
  voluntarySavings Float                           @default(0)
  totalSavings     Float                           @default(0)
  totalLoan        Float                           @default(0)
  totalPaid        Float                           @default(0)
  remainingLoan    Float                           @default(0)
  accumulatedSHU   Float                           @default(0)
  distributedSHU   Float                           @default(0)
  role             String                          @default("MEMBER")
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  loans            CooperativeDigitalLoan[]
  cooperative      CooperativeDigital              @relation(fields: [cooperativeId], references: [id])
  user             User                            @relation(fields: [userId], references: [id])
  savings          CooperativeDigitalSavings[]
  transactionsFrom CooperativeDigitalTransaction[] @relation("fromMember")
  transactionsTo   CooperativeDigitalTransaction[] @relation("toMember")
  votes            CooperativeDigitalVote[]
}

model CooperativeDigitalProduct {
  id             Int                @id @default(autoincrement())
  cooperativeId  Int
  productId      Int
  price          Float
  stock          Int                @default(0)
  isActive       Boolean            @default(true)
  memberDiscount Float              @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  cooperative    CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
}

model CooperativeDigitalSavings {
  id              Int                      @id @default(autoincrement())
  cooperativeId   Int
  memberId        Int
  type            String
  amount          Float
  description     String?
  transactionDate DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  cooperative     CooperativeDigital       @relation(fields: [cooperativeId], references: [id])
  member          CooperativeDigitalMember @relation(fields: [memberId], references: [id])
}

model CooperativeDigitalLoan {
  id                Int                             @id @default(autoincrement())
  cooperativeId     Int
  memberId          Int
  amount            Float
  interestRate      Float                           @default(0)
  tenure            Int
  purpose           String?
  status            CooperativeDigitalLoanStatus    @default(PENDING)
  approvedAt        DateTime?
  disbursedAt       DateTime?
  dueDate           DateTime
  paidAmount        Float                           @default(0)
  remainingAmount   Float                           @default(0)
  installmentAmount Float
  penaltyAmount     Float                           @default(0)
  lateDays          Int                             @default(0)
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  cooperative       CooperativeDigital              @relation(fields: [cooperativeId], references: [id])
  member            CooperativeDigitalMember        @relation(fields: [memberId], references: [id])
  payments          CooperativeDigitalLoanPayment[]
}

model CooperativeDigitalLoanPayment {
  id          Int                    @id @default(autoincrement())
  loanId      Int
  amount      Float
  principal   Float
  interest    Float
  penalty     Float                  @default(0)
  paymentDate DateTime               @default(now())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  loan        CooperativeDigitalLoan @relation(fields: [loanId], references: [id])
}

/// ============================================
model CooperativeDigitalTransaction {
  id            Int                               @id @default(autoincrement())
  cooperativeId Int
  memberId      Int?
  type          CooperativeDigitalTransactionType
  amount        Float
  description   String?
  toMemberId    Int?
  status        String                            @default("COMPLETED")
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt
  cooperative   CooperativeDigital                @relation(fields: [cooperativeId], references: [id])
  member        CooperativeDigitalMember?         @relation("fromMember", fields: [memberId], references: [id])
  toMember      CooperativeDigitalMember?         @relation("toMember", fields: [toMemberId], references: [id])
}

model CooperativeDigitalMeeting {
  id            Int                      @id @default(autoincrement())
  cooperativeId Int
  title         String
  description   String?
  date          DateTime
  location      String?
  onlineLink    String?
  hasVoting     Boolean                  @default(false)
  votingResults Json?
  status        String                   @default("SCHEDULED")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  cooperative   CooperativeDigital       @relation(fields: [cooperativeId], references: [id])
  votes         CooperativeDigitalVote[]
}

model CooperativeDigitalVote {
  id        Int                       @id @default(autoincrement())
  meetingId Int
  anggotaId Int
  choice    String
  comment   String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  anggota   CooperativeDigitalMember  @relation(fields: [anggotaId], references: [id])
  meeting   CooperativeDigitalMeeting @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, anggotaId])
}

model CooperativeDigitalAnnouncement {
  id            Int                @id @default(autoincrement())
  cooperativeId Int
  title         String
  content       String
  isUrgent      Boolean            @default(false)
  targetRole    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cooperative   CooperativeDigital @relation(fields: [cooperativeId], references: [id])
}

model VillageInfo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String
  imageUrl  String?
  isPinned  Boolean  @default(false)
  isUrgent  Boolean  @default(false)
  authorId  Int
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Complaint {
  id          Int                 @id @default(autoincrement())
  title       String
  description String
  category    String
  location    String?
  imageUrl    String?
  status      ComplaintStatus     @default(PENDING)
  reporterId  Int
  assignedTo  Int?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assigned    User?               @relation("AssignedComplaints", fields: [assignedTo], references: [id])
  reporter    User                @relation("UserComplaints", fields: [reporterId], references: [id])
  responses   ComplaintResponse[]
}

model ComplaintResponse {
  id          Int       @id @default(autoincrement())
  content     String
  isOfficial  Boolean   @default(false)
  complaintId Int
  authorId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
  complaint   Complaint @relation(fields: [complaintId], references: [id])
}

model VillageEvent {
  id           Int                       @id @default(autoincrement())
  title        String
  description  String?
  location     String
  startDate    DateTime
  endDate      DateTime
  category     String
  imageUrl     String?
  organizer    String
  contact      String?
  isPublished  Boolean                   @default(true)
  isFeatured   Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants VillageEventParticipant[]
}

model VillageEventParticipant {
  id        Int          @id @default(autoincrement())
  eventId   Int
  userId    Int
  status    String       @default("CONFIRMED")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  event     VillageEvent @relation(fields: [eventId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model VillageDocument {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  type        DocumentType
  fileUrl     String?
  requesterId Int
  officerId   Int?
  status      DocumentStatus @default(PENDING)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  officer     User?          @relation("DocumentOfficer", fields: [officerId], references: [id])
  requester   User           @relation("DocumentRequester", fields: [requesterId], references: [id])
}

model VillagePotential {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  category    String
  location    String?
  quantity    String?
  imageUrl    String?
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  verifiedBy  Int?
  submittedBy Int
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submitter   User      @relation(fields: [submittedBy], references: [id])
}

model Donation {
  id              Int             @id @default(autoincrement())
  title           String
  description     String
  targetAmount    Float
  collectedAmount Float           @default(0)
  category        String
  organizerId     Int
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean         @default(true)
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organizer       User            @relation(fields: [organizerId], references: [id])
  donors          DonationDonor[]
}

model DonationDonor {
  id          Int      @id @default(autoincrement())
  donationId  Int
  donorId     Int
  amount      Float
  isAnonymous Boolean  @default(false)
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  donation    Donation @relation(fields: [donationId], references: [id])
  donor       User     @relation(fields: [donorId], references: [id])
}

model DisasterInfo {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  type        String
  location    String
  severity    String
  reportedBy  Int
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reporter    User     @relation(fields: [reportedBy], references: [id])
}

model Enterprise {
  id           Int                     @id @default(autoincrement())
  name         String
  slug         String                  @unique
  description  String?
  type         BusinessType            @default(UMKM)
  logo         String?
  banner       String?
  address      String
  phone        String
  email        String
  website      String?
  isVerified   Boolean                 @default(false)
  verifiedAt   DateTime?
  verifiedBy   Int?
  status       String                  @default("ACTIVE")
  ownerId      Int                     @unique
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  owner        User                    @relation(fields: [ownerId], references: [id])
  analytics    EnterpriseAnalytic[]
  integrations EnterpriseIntegration[]
  members      EnterpriseMember[]
  orders       EnterpriseOrder[]
  products     EnterpriseProduct[]
  stores       EnterpriseStore[]
}

model EnterpriseStore {
  id           Int        @id @default(autoincrement())
  enterpriseId Int
  storeId      Int
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  store        Store      @relation(fields: [storeId], references: [id])

  @@unique([enterpriseId, storeId])
}

model EnterpriseMember {
  id           Int            @id @default(autoincrement())
  enterpriseId Int
  userId       Int
  role         EnterpriseRole @default(STAFF)
  permissions  Json?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  enterprise   Enterprise     @relation(fields: [enterpriseId], references: [id])
  user         User           @relation(fields: [userId], references: [id])

  @@unique([enterpriseId, userId])
}

model EnterpriseProduct {
  id           Int        @id @default(autoincrement())
  enterpriseId Int
  productId    Int
  price        Float
  stock        Int        @default(0)
  isActive     Boolean    @default(true)
  featured     Boolean    @default(false)
  weight       Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@unique([enterpriseId, productId])
}

model EnterpriseOrder {
  id           Int        @id @default(autoincrement())
  enterpriseId Int
  orderId      Int
  status       String     @default("PENDING")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id])

  @@unique([enterpriseId, orderId])
}

model EnterpriseIntegration {
  id           Int        @id @default(autoincrement())
  enterpriseId Int
  platform     String
  apiKey       String?
  apiSecret    String?
  accessToken  String?
  refreshToken String?
  isActive     Boolean    @default(true)
  lastSync     DateTime?
  settings     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
}

model EnterpriseAnalytic {
  id           Int        @id @default(autoincrement())
  enterpriseId Int
  date         DateTime
  revenue      Float      @default(0)
  orders       Int        @default(0)
  products     Int        @default(0)
  visitors     Int        @default(0)
  conversion   Float      @default(0)
  topProducts  Json?
  topStores    Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])

  @@index([enterpriseId, date])
}

model Farm {
  id          Int             @id @default(autoincrement())
  name        String
  location    String
  area        Float
  description String?
  imageUrl    String?
  farmerId    Int
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  farmer      User            @relation(fields: [farmerId], references: [id])
  commodities FarmCommodity[]
  logistics   FarmLogistics[]
  harvests    Harvest[]
}

model FarmCommodity {
  id               Int               @id @default(autoincrement())
  farmId           Int
  commodity        String
  category         CommodityCategory @default(SAYURAN)
  variety          String?
  plantingDate     DateTime
  harvestEstimate  DateTime
  areaPlanted      Float
  quantityEstimate Float
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  farm             Farm              @relation(fields: [farmId], references: [id])
  harvests         Harvest[]
}

model Harvest {
  id           Int              @id @default(autoincrement())
  farmId       Int
  commodityId  Int
  quantity     Float
  unit         String
  quality      CommodityQuality @default(STANDAR)
  harvestDate  DateTime
  expiryDate   DateTime?
  price        Float
  imageUrl     String?
  status       HarvestStatus    @default(PANEN)
  isAggregated Boolean          @default(false)
  aggregatedBy Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  logistics    FarmLogistics[]
  commodity    FarmCommodity    @relation(fields: [commodityId], references: [id])
  farm         Farm             @relation(fields: [farmId], references: [id])
}

model MarketPrice {
  id        Int               @id @default(autoincrement())
  commodity String
  category  CommodityCategory @default(SAYURAN)
  price     Float
  unit      String
  market    String
  quality   CommodityQuality  @default(STANDAR)
  date      DateTime          @default(now())
  source    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SeasonInfo {
  id                   Int      @id @default(autoincrement())
  season               String
  year                 Int
  description          String?
  prediction           String?
  startDate            DateTime
  endDate              DateTime
  recommendedCommodity String?
  tips                 String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model FarmOrder {
  id            Int              @id @default(autoincrement())
  buyerId       Int
  commodity     String
  quantity      Float
  unit          String
  targetPrice   Float?
  targetQuality CommodityQuality @default(STANDAR)
  harvestDate   DateTime?
  location      String?
  status        String           @default("OPEN")
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  buyer         User             @relation(fields: [buyerId], references: [id])
}

model FarmLogistics {
  id           Int      @id @default(autoincrement())
  farmId       Int
  harvestId    Int
  destination  String
  distance     Float?
  transport    String
  logisticsFee Float
  deliveryDate DateTime
  status       String   @default("SCHEDULED")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  farm         Farm     @relation(fields: [farmId], references: [id])
  harvest      Harvest  @relation(fields: [harvestId], references: [id])
}

model VillageEconomy {
  id                Int      @id @default(autoincrement())
  villageId         Int
  totalUMKM         Int      @default(0)
  totalRevenue      Float    @default(0)
  totalTransactions Int      @default(0)
  growthRate        Float    @default(0)
  month             Int
  year              Int
  topProducts       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  village           Village  @relation(fields: [villageId], references: [id])

  @@unique([villageId, month, year])
}

model Village {
  id                Int                @id @default(autoincrement())
  name              String
  district          String
  regency           String
  province          String
  latitude          Float?
  longitude         Float?
  population        Int?
  area              Float?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  products          Product[]
  umkm              UMKM[]
  users             User[]
  economy           VillageEconomy[]
  // deliveryLogistics VillageLogistics[] @relation("delivery")
  // pickupLogistics   VillageLogistics[] @relation("pickup")
}

model LocalReward {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  totalPoints     Int      @default(0)
  level           String   @default("PEMULA")
  localPurchases  Int      @default(0)
  totalPurchases  Int      @default(0)
  localPercentage Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

