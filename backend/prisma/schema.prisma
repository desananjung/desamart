generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ============================================
// MODEL USER - Tambahkan relasi UMKM
// ============================================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  cart      Cart?
  orders    Order[]
  store     Store?
  wishlist  WishlistItem[]
  reviews   Review[]
  payments  Payment[]
  umkm      UMKM?
  
  // Relasi untuk komunitas
  communityPosts   UMKMCommunity[]
  communityComments UMKMComment[]
  // TAMBAHKAN: Relasi Koperasi
   cooperativeAdmin  CooperativeDigital?
  cooperativeMember CooperativeDigitalMember[]
   // Relasi Enterprise
  enterpriseOwner  Enterprise?           // sebagai owner
  enterpriseMember EnterpriseMember[]    // sebagai member
  // Relasi Pertanian
  farms       Farm[]
  farmOrders  FarmOrder[]          // sebagai pembeli
  

  // ============================================
  // Relasi Layanan Desa
  // ============================================
  
  // Village Info
  villageInfos      VillageInfo[]
  
  // Complaints - dengan nama relasi
  complaints        Complaint[] @relation("UserComplaints")
  assignedComplaints Complaint[] @relation("AssignedComplaints")
  complaintResponses ComplaintResponse[]
  
  // Events
  eventParticipants VillageEventParticipant[]
  
  // Documents - dengan nama relasi
  documentRequests  VillageDocument[] @relation("DocumentRequester")
  documentOfficer   VillageDocument[] @relation("DocumentOfficer")
  
  // Village Potential
  villagePotentials VillagePotential[]
  
  // Donations
  donations         Donation[]
  donationDonors    DonationDonor[]
  
  // Disaster
  disasterReports   DisasterInfo[]
}

// ============================================
// MODEL STORE - Tambahkan @unique di storeId
// ============================================
model Store {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  banner      String?
  address     String?
  phone       String?
  isActive    Boolean  @default(true)
  rating      Float    @default(0)
  totalSales  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sellerId    Int      @unique
  seller      User     @relation(fields: [sellerId], references: [id])
  products    Product[]
  umkm        UMKM?

  // TAMBAHKAN: Relasi Enterprise
  enterpriseStores EnterpriseStore[]
}

// ============================================
// MODEL CATEGORY
// ============================================
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}

// ============================================
// MODEL PRODUCT - Tambahkan relasi ke UMKMProduct
// ============================================
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  price       Float    @default(0)
  stock       Int      @default(0)
  imageUrl    String?
  weight      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  sellerId    Int
  seller      User     @relation(fields: [sellerId], references: [id])
  storeId     Int?
  store       Store?   @relation(fields: [storeId], references: [id])

  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  umkmProducts  UMKMProduct[]
  
  // Relasi ke Promotion
  promotions  Promotion[]

  // TAMBAHKAN: Relasi Koperasi
  cooperativeProducts CooperativeDigitalProduct[]

  // TAMBAHKAN: Relasi Enterprise
  enterpriseProducts EnterpriseProduct[]
}

// ============================================
// MODEL CART
// ============================================
model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     CartItem[]
}

// ============================================
// MODEL CART_ITEM
// ============================================
model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
}

// ============================================
// MODEL ORDER
// ============================================
model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  total       Float       @default(0)
  status      OrderStatus @default(PENDING)
  address     String
  phone       String
  note        String?
  
  paymentMethod String?
  paymentStatus String?
  paymentProof  String?
  paidAt        DateTime?
  
  shippingMethod String?
  shippingCost   Float?
  shippingNumber String?
  trackingStatus String?
  deliveredAt    DateTime?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
  reviews     Review[]
  payments    Payment[]
  shipping    Shipping?

  // TAMBAHKAN: Relasi Enterprise
  enterpriseOrders EnterpriseOrder[]
}

// ============================================
// MODEL ORDER_ITEM
// ============================================
model OrderItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
}

// ============================================
// MODEL WISHLIST_ITEM
// ============================================
model WishlistItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// ============================================
// MODEL REVIEW
// ============================================
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
}

// ============================================
// MODEL PAYMENT
// ============================================
model Payment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  method      String
  amount      Float
  status      String
  proof       String?
  paidAt      DateTime?
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

// ============================================
// MODEL SHIPPING
// ============================================
model Shipping {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  order       Order    @relation(fields: [orderId], references: [id])
  
  method      String
  cost        Float
  trackingNumber String?
  status      String
  address     String
  receiverName String?
  receiverPhone String?
  
  shippedAt   DateTime?
  deliveredAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ============================================
// MODEL UMKM - PERBAIKI relasi store
// ============================================
model UMKM {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String
  subCategory String?
  address     String
  phone       String
  email       String
  website     String?
  socialMedia Json?
  
  isVerified  Boolean  @default(false)
  verifiedAt  DateTime?
  verifiedBy  Int?
  
  certificate String?
  certificateId String?
  
  status      String   @default("PENDING")
  
  businessLicense String?
  idCard       String?
  photo        String?
  
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  
  // PERBAIKAN: storeId harus unique untuk one-to-one
  storeId     Int      @unique
  store       Store    @relation(fields: [storeId], references: [id])
  
  products    UMKMProduct[]
  promotions  Promotion[]
  financialRecords FinancialRecord[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL UMKM_PRODUCT
// ============================================
model UMKMProduct {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  umkmId      Int
  umkm        UMKM     @relation(fields: [umkmId], references: [id])
  
  productionDate DateTime?
  expiryDate     DateTime?
  batchNumber    String?
  
  halal         Boolean @default(false)
  organic       Boolean @default(false)
  bpom          Boolean @default(false)
  bpomNumber    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL PROMOTION - PERBAIKI relasi
// ============================================
model Promotion {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  type        String
  
  discountType String
  discountValue Float
  
  startDate   DateTime
  endDate     DateTime
  
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
  umkmId      Int?
  umkm        UMKM?    @relation(fields: [umkmId], references: [id])
  
  isActive    Boolean  @default(true)
  
  maxUsage    Int      @default(-1)
  usedCount   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL UMKM_COMMUNITY - PERBAIKI author
// ============================================
model UMKMCommunity {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String
  
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  
  likes       Int      @default(0)
  views       Int      @default(0)
  
  status      String   @default("PUBLISHED")
  
  comments    UMKMComment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL UMKM_COMMENT - PERBAIKI relasi parent-child
// ============================================
model UMKMComment {
  id          Int      @id @default(autoincrement())
  content     String
  
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  postId      Int
  post        UMKMCommunity @relation(fields: [postId], references: [id])
  
  parentId    Int?
  parent      UMKMComment? @relation("UMKMCommentReplies", fields: [parentId], references: [id])
  
  // Relasi balik untuk children
  children    UMKMComment[] @relation("UMKMCommentReplies")
  
  likes       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL FINANCIAL_RECORD
// ============================================
model FinancialRecord {
  id          Int      @id @default(autoincrement())
  type        String
  category    String
  amount      Float
  description String
  date        DateTime
  reference   String?
  
  umkmId      Int
  umkm        UMKM     @relation(fields: [umkmId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
// ============================================
// ENUM KOPERASI DIGITAL
// ============================================
enum CooperativeDigitalType {
  KUD
  KSP
  KPRI
  KOPKAR
  LAINNYA
}

enum CooperativeDigitalStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CooperativeDigitalLoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PAID
  OVERDUE
  DEFAULTED
}

enum CooperativeDigitalTransactionType {
  DEPOSIT
  WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_PAYMENT
  SHU_DISTRIBUTION
  TRANSFER
  SERVICE_FEE
  PENALTY
}

// ============================================
// MODEL COOPERATIVE_DIGITAL
// ============================================
model CooperativeDigital {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  type        CooperativeDigitalType @default(KUD)
  description String?
  
  registrationNumber String
  establishmentDate DateTime
  address     String
  phone       String
  email       String
  website     String?
  
  certificateUrl String?
  logo          String?
  banner        String?
  
  status      CooperativeDigitalStatus @default(PENDING)
  verifiedAt  DateTime?
  verifiedBy  Int?
  
  adminId     Int      @unique
  admin       User     @relation(fields: [adminId], references: [id])
  
  members     CooperativeDigitalMember[]
  products    CooperativeDigitalProduct[]
  savings     CooperativeDigitalSavings[]
  loans       CooperativeDigitalLoan[]
  transactions CooperativeDigitalTransaction[]
  meetings    CooperativeDigitalMeeting[]
  announcements CooperativeDigitalAnnouncement[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_MEMBER
// ============================================
model CooperativeDigitalMember {
  id          Int      @id @default(autoincrement())
  cooperativeId Int
  cooperative  CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  memberNumber String   @unique
  joinDate    DateTime @default(now())
  isActive    Boolean  @default(true)
  
  mandatorySavings Float @default(0)
  voluntarySavings  Float @default(0)
  totalSavings      Float @default(0)
  
  totalLoan   Float @default(0)
  totalPaid   Float @default(0)
  remainingLoan Float @default(0)
  
  accumulatedSHU Float @default(0)
  distributedSHU Float @default(0)
  
  role        String @default("MEMBER")
  
  savings     CooperativeDigitalSavings[]
  loans       CooperativeDigitalLoan[]
  transactionsFrom CooperativeDigitalTransaction[] @relation("fromMember")
  transactionsTo   CooperativeDigitalTransaction[] @relation("toMember")
  votes       CooperativeDigitalVote[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_PRODUCT
// ============================================
model CooperativeDigitalProduct {
  id          Int      @id @default(autoincrement())
  cooperativeId Int
  cooperative  CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  
  price       Float
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  memberDiscount Float @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_SAVINGS
// ============================================
model CooperativeDigitalSavings {
  id          Int      @id @default(autoincrement())
  
  // TAMBAHKAN: Relasi ke CooperativeDigital
  cooperativeId Int
  cooperative  CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  
  memberId    Int
  member      CooperativeDigitalMember @relation(fields: [memberId], references: [id])
  
  type        String   // MANDATORY, VOLUNTARY
  amount      Float
  description String?
  transactionDate DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_LOAN
// ============================================
model CooperativeDigitalLoan {
  id          Int      @id @default(autoincrement())
  
  // TAMBAHKAN: Relasi ke CooperativeDigital
  cooperativeId Int
  cooperative  CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  
  memberId    Int
  member      CooperativeDigitalMember @relation(fields: [memberId], references: [id])
  
  amount      Float
  interestRate Float @default(0)
  tenure      Int
  purpose     String?
  
  status      CooperativeDigitalLoanStatus @default(PENDING)
  approvedAt  DateTime?
  disbursedAt DateTime?
  dueDate     DateTime
  
  paidAmount  Float @default(0)
  remainingAmount Float @default(0)
  installmentAmount Float
  
  penaltyAmount Float @default(0)
  lateDays    Int    @default(0)
  
  payments    CooperativeDigitalLoanPayment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_LOAN_PAYMENT
// ============================================
model CooperativeDigitalLoanPayment {
  id          Int      @id @default(autoincrement())
  loanId      Int
  loan        CooperativeDigitalLoan @relation(fields: [loanId], references: [id])
  
  amount      Float
  principal   Float
  interest    Float
  penalty     Float @default(0)
  
  paymentDate DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// ============================================
// MODEL COOPERATIVE_DIGITAL_TRANSACTION
// ============================================
model CooperativeDigitalTransaction {
  id          Int      @id @default(autoincrement())
  cooperativeId Int
  cooperative  CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  
  memberId    Int?
  member      CooperativeDigitalMember? @relation("fromMember", fields: [memberId], references: [id])
  
  type        CooperativeDigitalTransactionType
  amount      Float
  description String?
  
  toMemberId  Int?
  toMember    CooperativeDigitalMember? @relation("toMember", fields: [toMemberId], references: [id])
  
  status      String @default("COMPLETED")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_MEETING
// ============================================
model CooperativeDigitalMeeting {
  id          Int      @id @default(autoincrement())
  cooperativeId Int
  cooperative  CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  
  title       String
  description String?
  date        DateTime
  location    String?
  onlineLink  String?
  
  hasVoting   Boolean @default(false)
  votingResults Json?
  
  status      String @default("SCHEDULED")
  
  votes       CooperativeDigitalVote[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_VOTE
// ============================================
model CooperativeDigitalVote {
  id          Int      @id @default(autoincrement())
  meetingId   Int
  meeting     CooperativeDigitalMeeting @relation(fields: [meetingId], references: [id])
  
  anggotaId   Int
  anggota     CooperativeDigitalMember @relation(fields: [anggotaId], references: [id])
  
  choice      String   // YES, NO, ABSTAIN
  comment     String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([meetingId, anggotaId])
}

// ============================================
// MODEL COOPERATIVE_DIGITAL_ANNOUNCEMENT
// ============================================
model CooperativeDigitalAnnouncement {
  id          Int      @id @default(autoincrement())
  cooperativeId Int
  cooperative  CooperativeDigital @relation(fields: [cooperativeId], references: [id])
  
  title       String
  content     String
  isUrgent    Boolean @default(false)
  targetRole  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
// ============================================
// ENUM LAYANAN DESA
// ============================================
enum ComplaintStatus {
  PENDING
  PROCESSING
  RESOLVED
  REJECTED
}

enum DocumentType {
  KTP
  KK
  SURAT_KETERANGAN
  SURAT_USAHA
  REKOMENDASI
  LAINNYA
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// ============================================
// MODEL VILLAGE_INFO
// ============================================
model VillageInfo {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String
  imageUrl    String?
  isPinned    Boolean  @default(false)
  isUrgent    Boolean  @default(false)
  
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  
  views       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COMPLAINT
// ============================================
model Complaint {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String
  location    String?
  imageUrl    String?
  
  status      ComplaintStatus @default(PENDING)
  
  reporterId  Int
  reporter    User     @relation("UserComplaints", fields: [reporterId], references: [id])
  
  assignedTo  Int?
  assigned    User?    @relation("AssignedComplaints", fields: [assignedTo], references: [id])
  
  resolvedAt  DateTime?
  resolution  String?
  
  responses   ComplaintResponse[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL COMPLAINT_RESPONSE
// ============================================
model ComplaintResponse {
  id          Int      @id @default(autoincrement())
  content     String
  isOfficial  Boolean  @default(false)
  
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL VILLAGE_EVENT
// ============================================
model VillageEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  location    String
  startDate   DateTime
  endDate     DateTime
  
  category    String
  imageUrl    String?
  
  organizer   String
  contact     String?
  
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  
  participants VillageEventParticipant[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt   // ← PERBAIKI: @updatedA → @updatedAt
}

// ============================================
// MODEL VILLAGE_EVENT_PARTICIPANT
// ============================================
model VillageEventParticipant {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       VillageEvent @relation(fields: [eventId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  status      String   @default("CONFIRMED")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([eventId, userId])
}

// ============================================
// MODEL VILLAGE_DOCUMENT
// ============================================
model VillageDocument {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        DocumentType
  fileUrl     String?
  
  requesterId Int
  requester   User     @relation("DocumentRequester", fields: [requesterId], references: [id])
  
  officerId   Int?
  officer     User?    @relation("DocumentOfficer", fields: [officerId], references: [id])
  
  status      DocumentStatus @default(PENDING)
  notes       String?
  
  completedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL VILLAGE_POTENTIAL
// ============================================
model VillagePotential {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  category    String
  location    String?
  quantity    String?
  imageUrl    String?
  
  isVerified  Boolean  @default(false)
  verifiedAt  DateTime?
  verifiedBy  Int?
  
  submittedBy Int
  submitter   User     @relation(fields: [submittedBy], references: [id])
  
  views       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL DONATION
// ============================================
model Donation {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  targetAmount Float
  collectedAmount Float @default(0)
  category    String
  
  organizerId Int
  organizer   User     @relation(fields: [organizerId], references: [id])
  
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  
  imageUrl    String?
  
  donors      DonationDonor[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL DONATION_DONOR
// ============================================
model DonationDonor {
  id          Int      @id @default(autoincrement())
  donationId  Int
  donation    Donation @relation(fields: [donationId], references: [id])
  donorId     Int
  donor       User     @relation(fields: [donorId], references: [id])
  
  amount      Float
  isAnonymous Boolean  @default(false)
  
  message     String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL DISASTER_INFO
// ============================================
model DisasterInfo {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  type        String
  location    String
  severity    String
  
  reportedBy  Int
  reporter    User     @relation(fields: [reportedBy], references: [id])
  
  isActive    Boolean  @default(true)
  
  imageUrl    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
// ============================================
// ENUM ENTERPRISE
// ============================================
enum EnterpriseRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum BusinessType {
  UMKM
  KOPERASI
  TOKO
  DISTRIBUTOR
  MANUFAKTUR
  JASA
  LAINNYA
}

// ============================================
// MODEL ENTERPRISE
// ============================================
model Enterprise {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  type        BusinessType @default(UMKM)
  logo        String?
  banner      String?
  address     String
  phone       String
  email       String
  website     String?
  
  isVerified  Boolean  @default(false)
  verifiedAt  DateTime?
  verifiedBy  Int?
  
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  
  ownerId     Int      @unique
  owner       User     @relation(fields: [ownerId], references: [id])
  
  // Relasi
  stores      EnterpriseStore[]
  members     EnterpriseMember[]
  products    EnterpriseProduct[]
  orders      EnterpriseOrder[]
  integrations EnterpriseIntegration[]
  // TAMBAHKAN: Relasi ke EnterpriseAnalytic
  analytics   EnterpriseAnalytic[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL ENTERPRISE_STORE (Toko dalam Enterprise)
// ============================================
model EnterpriseStore {
  id          Int      @id @default(autoincrement())
  enterpriseId Int
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  
  name        String
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([enterpriseId, storeId])
}

// ============================================
// MODEL ENTERPRISE_MEMBER (Anggota Enterprise)
// ============================================
model EnterpriseMember {
  id          Int      @id @default(autoincrement())
  enterpriseId Int
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  role        EnterpriseRole @default(STAFF)
  permissions Json?     // { canManageProducts: true, canManageOrders: true, ... }
  
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([enterpriseId, userId])
}

// ============================================
// MODEL ENTERPRISE_PRODUCT (Produk Enterprise)
// ============================================
model EnterpriseProduct {
  id          Int      @id @default(autoincrement())
  enterpriseId Int
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  
  price       Float
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  
  // Marketing
  featured    Boolean  @default(false)
  weight      Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([enterpriseId, productId])
}

// ============================================
// MODEL ENTERPRISE_ORDER (Pesanan Enterprise)
// ============================================
model EnterpriseOrder {
  id          Int      @id @default(autoincrement())
  enterpriseId Int
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  
  status      String   @default("PENDING")
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([enterpriseId, orderId])
}

// ============================================
// MODEL ENTERPRISE_INTEGRATION (Integrasi Marketplace)
// ============================================
model EnterpriseIntegration {
  id          Int      @id @default(autoincrement())
  enterpriseId Int
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  
  platform    String   // SHOPEE, TOKOPEDIA, LAZADA, BUKALAPAK, INSTAGRAM
  apiKey      String?
  apiSecret   String?
  accessToken String?
  refreshToken String?
  
  isActive    Boolean  @default(true)
  lastSync    DateTime?
  
  settings    Json?    // { shopId: '', webhookUrl: '', ... }
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL ENTERPRISE_ANALYTIC (Analitik Enterprise)
// ============================================
model EnterpriseAnalytic {
  id          Int      @id @default(autoincrement())
  enterpriseId Int
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  
  date        DateTime
  revenue     Float    @default(0)
  orders      Int      @default(0)
  products    Int      @default(0)
  visitors    Int      @default(0)
  conversion  Float    @default(0)
  
  // Detail
  topProducts Json?    // { productId: '', sales: 0, revenue: 0 }
  topStores   Json?    // { storeId: '', sales: 0, revenue: 0 }
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([enterpriseId, date])
}
// ============================================
// ENUM PERTANIAN
// ============================================
enum CommodityCategory {
  PADI
  JAGUNG
  KEDELAI
  SAYURAN
  BUAH
  PALAWIJA
  PERKEBUNAN
  LAINNYA
}

enum CommodityQuality {
  PREMIUM
  STANDAR
  EKONOMI
  AFKIR
}

enum HarvestStatus {
  TANAM
  TUMBUH
  PANEN
  SELESAI
}

// ============================================
// MODEL FARM (Lahan Pertanian)
// ============================================
model Farm {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  area        Float
  description String?
  imageUrl    String?
  
  farmerId    Int
  farmer      User     @relation(fields: [farmerId], references: [id])
  
  isActive    Boolean  @default(true)
  
  commodities FarmCommodity[]
  harvests    Harvest[]
  logistics   FarmLogistics[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL FARM_COMMODITY (Komoditas Lahan)
// ============================================
model FarmCommodity {
  id          Int      @id @default(autoincrement())
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id])
  
  commodity   String
  category    CommodityCategory @default(SAYURAN)
  variety     String?
  
  plantingDate DateTime
  harvestEstimate DateTime
  
  areaPlanted Float
  quantityEstimate Float
  
  harvests    Harvest[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL HARVEST (Hasil Panen)
// ============================================
model Harvest {
  id          Int      @id @default(autoincrement())
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id])
  commodityId Int
  commodity   FarmCommodity @relation(fields: [commodityId], references: [id])
  
  quantity    Float
  unit        String
  
  quality     CommodityQuality @default(STANDAR)
  
  harvestDate DateTime
  expiryDate  DateTime?
  
  price       Float
  imageUrl    String?
  
  status      HarvestStatus @default(PANEN)
  
  isAggregated Boolean @default(false)
  aggregatedBy Int?
  
  logistics   FarmLogistics[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL MARKET_PRICE (Harga Pasaran)
// ============================================
model MarketPrice {
  id          Int      @id @default(autoincrement())
  commodity   String
  category    CommodityCategory @default(SAYURAN)
  
  price       Float
  unit        String
  
  market      String
  quality     CommodityQuality @default(STANDAR)
  
  date        DateTime @default(now())
  source      String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL SEASON_INFO (Informasi Musim)
// ============================================
model SeasonInfo {
  id          Int      @id @default(autoincrement())
  season      String   // HUJAN, KEMARAU, PERALIHAN
  
  year        Int
  description String?
  prediction  String?
  
  startDate   DateTime
  endDate     DateTime
  
  recommendedCommodity String?
  tips        String?
  
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL FARM_ORDER (Pesanan Hasil Tani)
// ============================================
model FarmOrder {
  id          Int      @id @default(autoincrement())
  buyerId     Int
  buyer       User     @relation(fields: [buyerId], references: [id])
  
  commodity   String
  quantity    Float
  unit        String
  
  targetPrice Float?
  targetQuality CommodityQuality @default(STANDAR)
  
  harvestDate DateTime?
  location    String?
  
  status      String   @default("OPEN")
  
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// MODEL FARM_LOGISTICS (Logistik Panen)
// ============================================
model FarmLogistics {
  id          Int      @id @default(autoincrement())
  farmId      Int
  farm        Farm     @relation(fields: [farmId], references: [id])
  harvestId   Int
  harvest     Harvest  @relation(fields: [harvestId], references: [id])
  
  destination String
  distance    Float?
  transport   String
  
  logisticsFee Float
  deliveryDate DateTime
  
  status      String   @default("SCHEDULED")
  
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
